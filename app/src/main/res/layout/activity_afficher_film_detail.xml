<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/filmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Titre du film"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/filmReleaseYear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Année de sortie"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/filmDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Description du film"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnReserver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Réserver un film 🛎️🎞️" />

    <Button
        android:id="@+id/btnRetourListe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Retour à la liste des films"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        />



</LinearLayout>
